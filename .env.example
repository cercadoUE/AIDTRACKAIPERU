# Copia este archivo a .env.local y ajusta los valores. NUNCA subas .env.local ni credenciales reales.

# Almacenamiento: file (local, data/local/db.json) | memory | dynamo
STORAGE=file
# Tabla DynamoDB (solo con STORAGE=dynamo)
DYNAMO_TABLE=aidtrack-dev

# IA: rules (sin AWS) | bedrock
AI_PROVIDER=rules
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Voz: off (usa Web Speech API del navegador) | aws (Amazon Transcribe)
TRANSCRIBE=off

# Clave de sesión. En local puede omitirse (se genera una por proceso).
# En producción usa AUTH_SECRET_ARN (Secrets Manager) o genera una con: openssl rand -hex 32
AUTH_SECRET=
AUTH_SECRET_ARN=

# Sembrar datos de demostración al arrancar en producción (1 = sí)
AUTO_SEED=
# Contraseña de las cuentas demo (obligatoria al sembrar en DynamoDB)
DEMO_PASSWORD=
# Permitir el reinicio de la demo desde /admin (0 = deshabilitado)
ALLOW_DEMO_RESET=1

# Prefijo de ruta si la app se sirve bajo un subpath (p. ej. /absproxy/3000). Vacío por defecto.
NEXT_BASE_PATH=

# Credenciales AWS: NO van aquí. Usa `aws login`, un perfil (~/.aws) o el rol de la Lambda.
AWS_REGION=us-east-1

# Id público del equipo en el portal de la Kiro IAthon (lo devuelve GET /health)
TEAM_ID=T062
# Contraseña demo mostrada en /login (se incrusta al compilar; vacía = no se muestra)
NEXT_PUBLIC_DEMO_PASSWORD=
